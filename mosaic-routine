function downloadICS(){
  const items=routineItems();
  const am=items.filter(x=>x.slots.am).sort((a,b)=>a.slots.am-b.slots.am).map((x,i)=>`${i+1}. ${x.name}`).join('\\n');
  const pm=items.filter(x=>x.slots.pm).sort((a,b)=>a.slots.pm-b.slots.pm).map((x,i)=>`${i+1}. ${x.name}`).join('\\n');
  const sup=items.filter(x=>x.slots.daily).map(x=>`• ${x.name}`).join('\\n');
  const t=new Date(); t.setDate(t.getDate()+3);
  const ds=t.toISOString().slice(0,10).replace(/-/g,'');
  const ev=(uid,time,title,desc)=>`BEGIN:VEVENT\r\nUID:${uid}-${ds}@mosaic-routine\r\nDTSTAMP:${ds}T000000Z\r\nDTSTART;TZID=Asia/Kolkata:${ds}T${time}\r\nDURATION:PT10M\r\nRRULE:FREQ=DAILY;COUNT=84\r\nSUMMARY:${title}\r\nDESCRIPTION:${desc}\r\nBEGIN:VALARM\r\nTRIGGER:PT0M\r\nACTION:DISPLAY\r\nDESCRIPTION:${title}\r\nEND:VALARM\r\nEND:VEVENT\r\n`;
  let ics='BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Mosaic Routine//EN\r\n';
  if(am||sup) ics+=ev('am','080000','Mosaic Routine: morning',(am||'')+(sup?'\\n\\nSupplements:\\n'+sup:''));
  if(pm) ics+=ev('pm','220000','Mosaic Routine: night',pm);
  ics+='END:VCALENDAR\r\n';
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([ics],{type:'text/calendar'}));
  a.download='mosaic-routine.ics'; a.click();
  toast('Reminders downloaded. Open the file to add them.');
}

/* ============================================================
   DOCK (sticky bottom action)
   ============================================================ */
function renderDock(){
  const d=$('#dock'), inner=$('#dockInner'), s=S.screen;
  const backBtn=`<button class="back" onclick="back()" aria-label="Back"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>`;
  let h='';
  if(s==='quiz'){
    const last=S.qstep===STEPS.length-1;
    const dis = S.qstep===0 && !S.p.g;
    h=backBtn+`<button class="cta" ${dis?'disabled':''} onclick="next()">${last?'Build my routine':'Next'}</button>`;
  } else if(s==='results'){
    const items=routineItems();
    h=`<button class="cta" ${items.length?'':'disabled'} onclick="addRoutineToBag()">Add routine to Mosaic Bag · ${rupee(monthly(items))}</button>`;
  } else if(s==='bag' && bagCount()){
    h=`<button class="back" onclick="go('${S.routine.length?'results':'landing'}')" aria-label="Back">${backBtn.match(/<svg[\s\S]*<\/svg>/)[0]}</button><button class="cta" onclick="go('checkout')">Checkout · ${rupee(totals().grand)}</button>`;
  } else if(s==='checkout'){
    h=`<button class="back" onclick="go('bag')" aria-label="Back">${backBtn.match(/<svg[\s\S]*<\/svg>/)[0]}</button><button class="cta" onclick="placeOrder()">Place order · ${rupee(totals().grand)}</button>`;
  }
  inner.innerHTML=h; d.hidden=!h;
}

let tt; function toast(m){ const t=$('#toast'); t.textContent=m; t.classList.add('show'); clearTimeout(tt); tt=setTimeout(()=>t.classList.remove('show'),2200); }
window.addEventListener('scroll',()=>$('#top').classList.toggle('scrolled',scrollY>4),{passive:true});

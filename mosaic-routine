/* ============================================================
   ENGINE: score → pick one per group → fit time → fit budget
   ============================================================ */
function computeRoutine(p){
  const eligible = P.filter(x=> (x.g==='any'||x.g===p.g) && (!x.minAge||p.age>=x.minAge))
    .map(x=>({x, s:x.score(p)})).filter(o=>o.s>0).sort((a,b)=>b.s-a.s);
  const byGroup={}; eligible.forEach(o=>{ if(!byGroup[o.x.group]) byGroup[o.x.group]=o; });
  // essentials (cleanse, moisturise, protect) get priority in the queue
  const CORE={cleanser:30, spf:28, moist:24};
  let queue = Object.values(byGroup).map(o=>({...o, s:o.s+(CORE[o.x.group]||0)})).sort((a,b)=>b.s-a.s);
  const left=[], picks=[];
  // greedy fill: highest priority first, respecting time (step count) and monthly budget
  const topCap=[0,3,6,10][p.time], supCap=[0,2,3,4][p.time];
  let t=0, su=0, spent=0;
  queue.forEach(o=>{
    if(o.x.sup ? su>=supCap : t>=topCap){ left.push({...o,why:'time'}); return; }
    if(spent+o.x.price>p.budget){ left.push({...o,why:'budget'}); return; }
    picks.push(o); spent+=o.x.price; o.x.sup?su++:t++;
  });
  left.sort((a,b)=>b.s-a.s);
  return {routine:picks.map(o=>o.x.id), left:left.map(o=>({id:o.x.id, why:o.why}))};
}

function build(){
  go('loading');
  const msgs=['Reading your answers…','Scanning 30+ products across 3 brands…','Picking one per step and fitting it to your time and budget…','Writing your timeline…'];
  let i=0; $('#loadMsg').textContent=msgs[0];
  const iv=setInterval(()=>{ i++; if(i<msgs.length) $('#loadMsg').textContent=msgs[i]; },550);
  const r=computeRoutine(S.p); S.routine=r.routine; S.left=r.left; S.tab='am';
  setTimeout(()=>{ clearInterval(iv); go('results'); }, 2300);
}

